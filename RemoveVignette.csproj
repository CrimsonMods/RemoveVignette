<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>RemoveVignette</AssemblyName>
    <Description>Removes Vignette</Description>
    <Version>1.2.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Authors>CrimsonMods, iZastic</Authors>
    <PackageId>$(AssemblyName)</PackageId>
  </PropertyGroup>

  <Target Name="Thunderstore Copy to Dist" AfterTargets="AfterBuild" Condition=" '$(Configuration' == 'Release'">
		<Copy SourceFiles="$(OutDir)\RemoveVignette.dll" DestinationFolder="$(SolutionDir)/dist" />
	</Target>

  <ItemGroup>
    <PackageReference Include="VRising.UnhollowedX.Client" Version="1.0.8" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile" />
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\PluginInfo.props" />
  <Import Project="$(MSBuildProjectDirectory)\Manifest.props" />

</Project>
